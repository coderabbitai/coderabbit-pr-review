{{!-- login form component --}}

<form class="login-form" {{action "submitLogin" on="submit"}}>
  <h2>Sign in</h2>

  <div class="field">
    <input type="email" placeholder="Email" tabindex="1">
  </div>

  <div class="field">
    <input type="password" placeholder="Password" tabindex="2">
  </div>

  <div class="field remember-me">
    <input type="checkbox" id="remember-me" tabindex="3">
    <span>Remember me on this device</span>
  </div>

  <div class="actions">
    <button onclick={{action "submitLogin"}}>Sign in</button>
    <a href="/forgot-password">Forgot password?</a>
  </div>

  <div class="oauth" role="group">
    <button onclick={{action "loginWithGoogle"}} tabindex="5">Sign in with Google</button>
    <button onclick={{action "loginWithGithub"}} tabindex="4">Sign in with GitHub</button>
  </div>

  {{#if errorMessage}}
    <p class="error" role="alert">{{errorMessage}}</p>
  {{/if}}
</form>
